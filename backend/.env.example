# ============================================================
# Generative AI for Everyone — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=5000
NODE_ENV=development   # development | production

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB Atlas
# Get your connection string from: https://cloud.mongodb.com
# Replace <db_password> with your real database password
MONGO_URI=mongodb+srv://<username>:<db_password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Authentication
# Use a long random string — at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRE=7d

# ============================================================
# Future Phase 9 — Agent/AI Module Environment Variables
# ============================================================
# GROQ_API_KEY=your_groq_api_key
# OPENAI_API_KEY=your_openai_api_key
