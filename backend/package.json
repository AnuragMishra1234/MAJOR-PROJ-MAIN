{
  "name": "generative-ai-for-everyone-backend",
  "version": "1.0.0",
  "description": "Backend for Generative AI for Everyone — Node.js/Express/MongoDB",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:workflow": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/workflow --runInBand",
    "test:auth": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/auth --runInBand"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {}
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
