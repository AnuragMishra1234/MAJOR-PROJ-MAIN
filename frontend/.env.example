# GENERATIVE AI FOR EVERYONE — Frontend Environment Variables
# Copy this file to .env and fill in values

# ── API Configuration ──────────────────────────────────────────
# URL of Person 2's backend API
# Default: http://localhost:5000
VITE_API_URL=http://localhost:5000

# ── Mock Mode ──────────────────────────────────────────────────
# Set to 'false' to use the real backend API (Person 2's server must be running)
# Set to 'true' (default) to use realistic mock data — no backend required
VITE_USE_MOCK=true
